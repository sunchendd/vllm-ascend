@@ -530,6 +534,20 @@ class GPUModelRunner(
                     f"{self.speculative_config.method}"
                 )
             self.rejection_sampler = RejectionSampler(self.sampler)
+            ears_tolerance = float(os.getenv("VLLM_EARS_TOLERANCE", "0.0"))
