diff -Nur vllm.baseline/vllm/config/sparse.py vllm/vllm/config/sparse.py
--- vllm.baseline/vllm/config/sparse.py	1970-01-01 08:00:00.000000000 +0800
+++ vllm/vllm/config/sparse.py	2026-02-05 10:23:38.393569867 +0800
@@ -0,0 +1,675 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import hashlib
+import math
+from typing import Any, ClassVar, Literal, Optional, Type, Union, Dict, get_args, TYPE_CHECKING
+from abc import ABC, abstractmethod
+
+from pydantic import SkipValidation, model_validator, field_validator, Field
+from pydantic.dataclasses import dataclass
+from typing_extensions import Self
+
+from vllm.config.utils import config
+from vllm.logger import init_logger
+from .sparse_rules import sparse_config_inferers, crsa_algo_inferers
+if TYPE_CHECKING:
+    from .vllm import VllmConfig
+
+logger = init_logger(__name__)
+
+
+SparseAlgoType = Literal[
+    "QSA",   # Quest Sparse Attention
+    "CRSA",  # Cluster Retrieved Sparse Attention
+    "BMSA"   # Block-Mean Sparse Attention
+    # Others
+]
+
+HeadBudgetPolicy = Literal["uniform", "dynamic"]
+
+LayerPolicyType = Literal["mix", "all_sparse"]
+
+# Registry for sparse algorithm configs
+_SPARSE_ALGO_CONFIG_REGISTRY: dict[str, Type] = {}
+
+
+def register_sparse_algo(algorithm: str):
+    """Decorator to register sparse algorithm configuration classes.
+
+    Args:
+        algorithm: The name of the sparse algorithm.
+
+    Usage:
+        @register_sparse_algo("QSA")
+        @config
+        @dataclass
+        class QuestConfig:
+            ...
+
+    Raises:
+        ValueError: If the algorithm is already registered.
+    """
+
+    def decorator(cls):
+        # Check for duplicate registration
+        if algorithm in _SPARSE_ALGO_CONFIG_REGISTRY:
+            existing_cls = _SPARSE_ALGO_CONFIG_REGISTRY[algorithm]
+            raise ValueError(
+                f"Sparse algorithm '{algorithm}' is already registered with class '{existing_cls.__name__}'.")
+
+        # Warn if algorithm is not in SparseAlgoType Literal
+        valid_algorithms = get_args(SparseAlgoType)
+        if algorithm not in valid_algorithms:
+            logger.warning(
+                f"Registering algorithm '{algorithm}' which is not declared in "
+                f"SparseAlgoType Literal. Valid algorithms are: {valid_algorithms}. ")
+
+        _SPARSE_ALGO_CONFIG_REGISTRY[algorithm] = cls
+
+        # Store algorithm name on class for potential reverse lookup
+        cls._algorithm_name = algorithm
+        return cls
+
+    return decorator
+
+
+@config
+@dataclass
+class BaseSparseAlgoConfig(ABC):
+    """Base class for all sparse algorithm configurations."""
+
+    @abstractmethod
+    def get_blocks_budget(self, prompt_len: int, block_size: int, total_budget: float) -> int:
+        raise NotImplementedError()
+
+    def finalize(self, vllm_config: "VllmConfig") -> None:
+        return
+
+
+@register_sparse_algo("QSA")
+@config
+@dataclass
+class QSAConfig(BaseSparseAlgoConfig):
+    """Configuration for Quest sparse algorithm.
+
+    Quest is a budget-controlled sparse attention mechanism that dynamically
+    selects important tokens based on page's max key.
+    """
+
+    def get_blocks_budget(
+            self,
+            prompt_len: int,
+            block_size: int,
+            total_budget: float,
+    ) -> int:
+        pass
+
+
+@register_sparse_algo("BMSA")
+@config
+@dataclass
+class BMSAConfig(BaseSparseAlgoConfig):
+    """Configuration for Mean Block sparse algorithm.
+
+    BMSA is a budget-controlled sparse attention mechanism that dynamically
+    selects important tokens based on block's mean key.
+    """
+    min_topk_len = 64
+    max_topk_len = 512
+    num_prefetch_blocks = 8
+    init_windows_size = 8
+    ptopk_prefetch_enable = True
+    topk_update_interval = 3
+    align_kv_cache = False
+    enable_cuda_topk = False
+    topk_type: Literal["block-mean", "paged-kmeans"] = "block-mean"
+    kmeans_centroid_topk_ratio: float = 0.20
+    kmeans_topk_backend: Literal["cutlass", "torch"] = "cutlass"
+
+    def get_blocks_budget(
+            self,
+            prompt_len: int,
+            block_size: int,
+            total_budget: float,
+    ) -> int:
+        if prompt_len <= 0:
+            return 0
+        if total_budget is None or total_budget <= 0:
+            return 0
+
+        blocks_len = int(math.ceil(prompt_len / block_size))
+        if total_budget < 1:
+            topk_len = int(math.ceil(blocks_len * float(total_budget)))
+        else:
+            topk_len = int(math.ceil(total_budget / block_size))
+
+        if topk_len < self.min_topk_len:
+            topk_len = min(self.min_topk_len, blocks_len)
+        elif topk_len > self.max_topk_len:
+            topk_len = min(self.max_topk_len, blocks_len)
+        return topk_len
+
+    def finalize(self, vllm_config: "VllmConfig") -> None:
+        kv_transfer_config = getattr(vllm_config, "kv_transfer_config", None)
+        if kv_transfer_config is None:
+            return
+        extra = getattr(kv_transfer_config, "kv_connector_extra_config", None)
+        if extra is None:
+            kv_transfer_config.kv_connector_extra_config = {}
+            extra = kv_transfer_config.kv_connector_extra_config
+
+        sparse_connectors = extra.get("sparse_connectors")
+        if not isinstance(sparse_connectors, list) or not sparse_connectors:
+            return
+
+        has_capacity_hint = False
+        for item in sparse_connectors:
+            if not isinstance(item, dict):
+                continue
+            if item.get("connector_name") != "LocalStoreKVStore":
+                continue
+            connector_config = item.get("connector_config")
+            if (isinstance(connector_config, dict)
+                    and connector_config.get("capacity") is not None):
+                has_capacity_hint = True
+                break
+        if not has_capacity_hint:
+            return
+
+        from vllm.utils.torch_utils import get_kv_cache_torch_dtype
+        import torch
+
+        kv_cache_dtype = get_kv_cache_torch_dtype(
+            vllm_config.cache_config.cache_dtype,
+            vllm_config.model_config.dtype,
+        )
+        elem_size = int(torch.tensor([], dtype=kv_cache_dtype).element_size())
+        head_size = int(vllm_config.model_config.get_head_size())
+        num_kv_heads = int(
+            vllm_config.model_config.get_num_kv_heads(vllm_config.parallel_config))
+        num_layers = int(
+            vllm_config.model_config.get_num_layers(vllm_config.parallel_config))
+        block_size = int(vllm_config.cache_config.block_size)
+        is_mla = bool(getattr(vllm_config.model_config, "is_deepseek_mla", False))
+
+        tensor_size = block_size * num_kv_heads * head_size * elem_size
+        kv_block_size = tensor_size * num_layers * (1 if is_mla else 2)
+        if kv_block_size <= 0:
+            return
+
+        for item in sparse_connectors:
+            if not isinstance(item, dict):
+                continue
+            if item.get("connector_name") != "LocalStoreKVStore":
+                continue
+            connector_config = item.get("connector_config")
+            if connector_config is None or not isinstance(connector_config, dict):
+                connector_config = {}
+                item["connector_config"] = connector_config
+            capacity_gb = connector_config.get("capacity", None)
+            if capacity_gb is None:
+                continue
+            try:
+                capacity_gb_f = float(capacity_gb)
+            except (TypeError, ValueError):
+                continue
+            if capacity_gb_f <= 0:
+                continue
+
+            capacity_bytes = int(math.ceil(capacity_gb_f * (1024**3)))
+            capacity_blocks = max(int(math.ceil(capacity_bytes / kv_block_size)), 1)
+            connector_config["capacity"] = capacity_blocks
+
+
+@register_sparse_algo("CRSA")
+@config
+@dataclass
+class CRSAConfig(BaseSparseAlgoConfig):
+    """Configuration for ClusterRetrieved sparse algorithm.
+
+    ClusterRetrieved uses clustering-based retrieval to identify relevant tokens
+    for attention computation, significantly reducing memory and compute overhead.
+    """
+
+    num_sink_blocks: Optional[int] = None
+    """Number of token blocks at the beginning of the context sequence (attention sink).
+    This value may vary across different model architectures. Set to 'auto' to let the
+    engine automatically determine the optimal value based on the model."""
+
+    num_local_window_blocks: Optional[int] = None
+    """Number of token blocks at the end of the context sequence (local window).
+    This value may vary across different model architectures. Set to 'auto' to let the
+    engine automatically determine the optimal value based on the model."""
+
+    num_prefetch_blocks: Optional[int] = None
+    """Number of token blocks to prefetch before each iteration. Increasing this value may 
+    improve the hit rate of HotCache blocks, but it also incurs additional computational overhead.
+    """
+
+    dual_retrieved_buffer: bool = True
+    """Whether to allocate and use an extra retrieved-zone workspace buffer.
+
+    When enabled (default), CRSA may keep an extra set of retrieved KV blocks so
+    asynchronous recall can write into the inactive buffer and swap the retrieved
+    block-table view at the next step. This reduces read/write conflicts at the
+    cost of extra KV cache memory.
+    """
+
+    num_centroids: Optional[int] = None
+    """Number of cluster centroids. This determines how many clusters the context is
+    divided into. For example, if context length is 64K and n_centroids is 2048,
+    each cluster contains approximately: 65536 / 2048 ≈ 32 tokens/cluster.
+    Recommended value: context_length / 16 to context_length / 32."""
+
+    num_segments: Optional[int] = None
+    """Number of segments for segmented clustering. Used to accelerate the clustering
+    process while maintaining high semantic cohesion within each cluster. For example,
+    if context length is 64K, n_centroids is 2048, and n_segment is 8, then every 8K
+    tokens form a segment, and K-Means clustering is performed on each segment to get:
+    2048 / 8 = 256 clusters per segment."""
+
+    new_cluster_generated_threshold: int = 1024
+    """Cumulative generated token threshold that triggers new cluster updates.
+    When the number of newly generated tokens exceeds this threshold, the clustering
+    index will be updated to include the new tokens."""
+
+    num_centroids_per_iter: int = 64
+    """Number of new cluster centroids added per update iteration. For example,
+    1024 / 64 = 16 tokens/cluster, which is denser than the initial 32 tokens/cluster,
+    because the local window is more important for generation quality."""
+
+    max_compute_cluster_num: Optional[int] = None
+    """Maximum number of clusters to consider. Supports automatic inference, which is
+    the sum of clusters in the retrieval region and the estimation region."""
+
+    sparse_gpu_memory_utilization: float = Field(default=0.1, gt=0, le=1)
+    """GPU memory utilization reserved for sparse requests. Value should be between
+    0.0 and 1.0, representing the fraction of GPU memory pre-allocated for sparse
+    attention data structures (e.g., clustering indices, retrieval buffers)."""
+
+    full_kv_cpu_buffer: float = 128
+    """Size of the CPU full kv buffer per GPU (in GiB)."""
+
+    pipeline_window_size: int = Field(default=2, ge=1)
+    """Pipeline window size for step-stale TopK usage.
+    - 1: fully synchronous (TopK_t and KV recall happen in the same step t).
+    - >1: allow using TopK from previous steps (bounded staleness) to overlap
+      TopK/IO with attention compute.
+    """
+
+    sparsify_generated_tokens: bool = False
+    """Whether to apply sparsification to generated (decode) tokens.
+
+    Current CRSA production semantics only sparsify prompt tokens; generated tokens
+    remain fully kept in GPU KV to preserve simplicity and stability.
+    """
+
+    @model_validator(mode='after')
+    def _verify_model_args(self) -> Self:
+        """Verify CRSA configuration."""
+        if self.sparsify_generated_tokens:
+            raise ValueError(
+                "CRSAConfig.sparsify_generated_tokens=True is not supported in this "
+                "version. Current CRSA only sparsifies prompt tokens; generated "
+                "tokens are kept dense."
+            )
+        return self
+
+    def finalize(self, vllm_config: "VllmConfig"):
+        """
+        finalize: support field value auto inferable.
+        this method will be called after vllm_config.__post_init__().
+        """
+        crsa_algo_inferers.run(self, vllm_config)
+
+    def get_blocks_budget(
+            self,
+            blocks_len: int,
+            block_size: int,
+            total_budget: float,
+    ) -> int:
+        """
+        Note, blocks_len is prompts_len in CRSA.
+        """
+        if total_budget is None or total_budget <= 0:
+            return 0
+
+        if total_budget < 1:
+            budget_tokens = int(math.ceil(blocks_len * float(total_budget)))
+        else:
+            budget_tokens = int(total_budget)
+
+        budget_tokens = min(budget_tokens, int(blocks_len))
+        return int(math.ceil(budget_tokens / int(block_size)))
+
+
+# Union type for all algorithm-specific configs
+AlgorithmConfig = Union[
+    QSAConfig,
+    CRSAConfig,
+    BMSAConfig,
+]
+
+
+@config
+@dataclass
+class LayerSparsePolicy:
+    """Configuration for layer-wise sparse policy.
+
+    Allows hybrid configurations where some layers use sparse attention while
+    others use full attention.
+    """
+
+    policy_type: LayerPolicyType = "all_sparse"
+    """Layer sparsification strategy:\n
+    - 'mix': Mixed mode, where some layers use sparse attention and others use full attention.
+             When this mode is enabled, either full_attn_layers or sparse_layers must be specified.\n
+    - 'all_sparse': All layers use sparse attention."""
+
+    full_attn_layers: Optional[list[int]] = None
+    """List of layer indices that should use full attention (dense attention).
+    Only effective when policy_type is 'mix'. Example: [0, 1, 2, 31] means layers
+    0, 1, 2, and 31 will use full attention while other layers use sparse attention.
+    Cannot be specified together with sparse_layers."""
+
+    sparse_layers: Optional[list[int]] = None
+    """List of layer indices that should use sparse attention.
+    Only effective when policy_type is 'mix'. Example: [3, 4, 5, 30] means layers
+    3, 4, 5, and 30 will use sparse attention while other layers use full attention.
+    Cannot be specified together with full_attn_layers."""
+
+    @model_validator(mode='after')
+    def _verify_layer_policy(self) -> Self:
+        """Validate layer policy configuration."""
+        if self.policy_type == "mix":
+            # Exactly one of full_attn_layers or sparse_layers must be specified
+            if self.full_attn_layers is None and self.sparse_layers is None:
+                raise ValueError(
+                    "When policy_type is 'mix', either full_attn_layers or "
+                    "sparse_layers must be specified.")
+
+            if self.full_attn_layers is not None and self.sparse_layers is not None:
+                raise ValueError(
+                    "Cannot specify both full_attn_layers and sparse_layers. "
+                    "Please specify only one of them.")
+
+            # Validate layer indices are non-negative
+            layers_to_check = self.full_attn_layers or self.sparse_layers
+            if layers_to_check and any(idx < 0 for idx in layers_to_check):  # type: ignore
+                raise ValueError("Layer indices must be non-negative.")
+
+        elif self.policy_type == "all_sparse":
+            # Warn if layers are specified but will be ignored
+            if self.full_attn_layers is not None or self.sparse_layers is not None:
+                logger.warning(
+                    "policy_type is 'all_sparse', but full_attn_layers or "
+                    "sparse_layers is specified. These will be ignored.")
+
+        return self
+
+
+def _get_config_type_for_algo(algorithm: str) -> Type:
+    """Get the configuration class type for a given algorithm.
+
+    Args:
+        algorithm: The name of the sparse algorithm.
+
+    Returns:
+        The configuration class for the specified algorithm.
+
+    Raises:
+        ValueError: If the algorithm is not registered.
+    """
+    if algorithm not in _SPARSE_ALGO_CONFIG_REGISTRY:
+        available = list(_SPARSE_ALGO_CONFIG_REGISTRY.keys())
+        raise ValueError(
+            f"Unknown sparse algorithm: '{algorithm}'. "
+            f"Available algorithms: {available}")
+    return _SPARSE_ALGO_CONFIG_REGISTRY[algorithm]
+
+
+def get_registered_sparse_algos() -> list[str]:
+    """Get list of all registered sparse algorithms.
+
+    Returns:
+        A list of registered algorithm names.
+    """
+    return list(_SPARSE_ALGO_CONFIG_REGISTRY.keys())
+
+
+@config
+@dataclass
+class SparseConfig:
+    """Configuration for Sparse KV cache and Sparse Attention.
+
+    Sparse attention can significantly reduce memory footprint and
+    computation cost for long context scenarios by selectively attending to
+    relevant tokens instead of all tokens in the sequence.
+    """
+
+    DEFAULT_MAX_NUM_SEQS: ClassVar[int] = 32
+
+    enable_sparse: bool = False
+    """Enable/Disable sparse attention. When set to True, sparse
+    inference is enabled. When False, all other sparse-related configurations are
+    ignored and standard dense attention is used."""
+
+    lc_sparse_threshold: Optional[int] = None
+    """Context length threshold to activate sparse attention. If specified,
+    sparse attention is only activated when the sequence length exceeds this
+    threshold. If None, sparse attention is controlled solely by `enable_sparse`.
+    This allows using dense attention for short sequences and sparse attention
+    for long sequences to balance accuracy and efficiency. This threshold is 
+    automatically evaluated by the sparsity algorithm in actual environment."""
+
+    sparse_algo_type: SparseAlgoType = "BMSA"
+    """Sparse attention algorithm to use. Supported algorithms:\n
+    - "QSA": Quest sparse attention with budget control\n
+    - "CRSA": Retrieval-augmented attention using clustering\n
+    - "BMSA": Mean Block Sparse Attention\n
+    """
+
+    sparse_algo_config: Optional[AlgorithmConfig] = None
+    """Algorithm-specific configuration. The type should match the selected
+    `sparse_algo_type`. If None, default configuration for the algorithm will
+    be used.
+    """
+
+    enable_static_sparse: bool = False
+    """Whether to enable static sparse methods. Reserved for future static sparse
+    techniques such as SnapKV, Ada-KV, H2O, etc."""
+
+    max_num_seqs: int = Field(default=DEFAULT_MAX_NUM_SEQS, ge=1)
+    """Maximum number of requests to enable sparse attention.
+    If the number of requests exceeds this threshold, sparse attention will be disabled.
+    """
+
+    head_budget_policy: HeadBudgetPolicy = "uniform"
+    """Head-granularity budget allocation policy:\n
+    - 'uniform': Uniform distribution of budget across all attention heads\n
+    - 'dynamic': Dynamic allocation based on context length, model parameters,
+      and attention head patterns. The inference engine will dynamically allocate
+      token budget for each head.\n
+    """
+
+    total_budget: float = 0.3
+    """Total token budget for sparse attention, default is 30%.\n
+
+    Notes:\n
+    - 0 is allowed (disables sparse attention).\n
+    - The value must not exceed the model's maximum context length.\n
+    - When the value is less than 1, the budget is set based on the percentage count, 
+      otherwise, it is set according to the specific given value.\n
+    """
+
+    topk_oversample: float = Field(default=1.25, gt=0)
+    """TopK oversample ratio for CRSA.\n
+\n
+    This is only used when `sparse_algo_type == "CRSA"`.\n
+\n
+    Motivation:\n
+    - CRSA retrieves tokens by selecting TopK clusters, but clusters can be highly imbalanced
+      (small clusters / empty clusters).\n
+    - Oversampling clusters increases the chance that recalled tokens can fully fill the
+      sparse retrieved KVBlocks budget.\n
+    """
+
+    enable_dynamic_budgets: bool = True
+    """Enable dynamic budgets, which allows the system to automatically determine the 
+    sparsity budget based on variations such as prompt length and model specifications.\n
+    When enable_dynamic_budgets is set to True, the value of total_budgets will be ignored.\n"""
+
+    layer_policy: Optional[LayerSparsePolicy] = None
