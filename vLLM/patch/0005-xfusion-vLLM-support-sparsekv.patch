+    LayerSparsePolicy(policy_type='all_sparse')."""
+
+    def finalize(self, vllm_config: "VllmConfig"):
+        """
+        finalize: support field value auto inferable.
+        this method will be called after vllm_config.__post_init__().
+        """
+
+        # 1.finalize sparse_config
+        sparse_config_inferers.run(self, vllm_config)
+
+        # 2.finalize sparse_algo_config
+        self.sparse_algo_config.finalize(vllm_config)
+
+    def __post_init__(self) -> None:
+
+        if not self.enable_sparse:
+            return
+
+        if self.total_budget is not None and self.total_budget <= 0:
+            logger.warning(
+                f"Sparse attention is enabled but budgets are less than 0, force to disable sparse attention."
+            )
+            self.enable_sparse = False
+            return
+
+        # Set default algorithm config if not provided
+        if self.enable_sparse and self.sparse_algo_config is None:
+            config_class = _get_config_type_for_algo(self.sparse_algo_type)
+            self.sparse_algo_config = config_class()
+
+            logger.info(
+                f"Using default configuration for sparse algorithm "
+                f"'{self.sparse_algo_type}': {self.sparse_algo_config}"
+            )
+
+        # Set default layer policy if not provided
+        if self.layer_policy is None:
+            self.layer_policy = LayerSparsePolicy()
+
+        if self.lc_sparse_threshold is not None and self.lc_sparse_threshold < 0:
+            raise ValueError(
+                f"lc_sparse_threshold must be non-negative, but got "
+                f"{self.lc_sparse_threshold}"
+            )
+
+        if self.sparse_algo_type == "CRSA" and self.lc_sparse_threshold is None:
+            self.lc_sparse_threshold = 8 * 1024
+
+        # Complex validation only if sparse is enabled
+        self._verify_sparse_config()
+
+    def get_blocks_budget(self, prompt_len: int, block_size: int) -> int:
+        if prompt_len <= 0:
+            return 0
+        if block_size <= 0:
+            raise ValueError("block_size must be positive")
+
+        assert self.sparse_algo_config is not None
+        return self.sparse_algo_config.get_blocks_budget(prompt_len, block_size, self.total_budget)
+
+    def _verify_sparse_config(self) -> None:
+        """Verify the sparse configuration is valid.
+
+        This is called from @model_validator to ensure all Pydantic
+        validations have completed before we do isinstance checks.
+        """
+        # Verify sparse algorithm is valid and registered
+        valid_algorithms = get_args(SparseAlgoType)
+        if self.sparse_algo_type not in valid_algorithms:
+            raise ValueError(
+                f"Unknown sparse algorithm: '{self.sparse_algo_type}'. "
+                f"Must be one of {valid_algorithms}"
+            )
+
+        # Verify the algorithm is actually registered
+        if self.sparse_algo_type not in _SPARSE_ALGO_CONFIG_REGISTRY:
+            raise ValueError(
+                f"Sparse algorithm '{self.sparse_algo_type}' is declared in "
+                f"SparseAlgoType but has no registered configuration class. "
+                f"Registered algorithms: {get_registered_sparse_algos()}"
+            )
+
+        # Verify algo_config matches the selected algorithm
+        if self.sparse_algo_config is not None:
+            expected_config_type = _get_config_type_for_algo(self.sparse_algo_type)
+            if not isinstance(self.sparse_algo_config, expected_config_type):
+                raise ValueError(
+                    f"sparse_algo_config type mismatch: expected "
+                    f"{expected_config_type.__name__} for algorithm "
+                    f"'{self.sparse_algo_type}', but got "
+                    f"{type(self.sparse_algo_config).__name__}"
+                )
+
+    def compute_hash(self) -> str:
+        """
+        Provide a hash that uniquely identifies all the configs
+        that affect the computation graph structure.
+        """
+        if not self.enable_sparse:
+            return hashlib.md5(b"sparse_disabled",
+                               usedforsecurity=False).hexdigest()
+
+        factors: list[Any] = []
+        factors.append(self.enable_sparse)
+        factors.append(self.lc_sparse_threshold)
+        factors.append(self.sparse_algo_type)
+        factors.append(self.enable_static_sparse)
+        factors.append(self.head_budget_policy)
+        factors.append(self.total_budget)
+
+        # Add layer policy
+        if self.layer_policy is not None:
+            factors.append(self.layer_policy.policy_type)
+            factors.append(str(self.layer_policy.full_attn_layers))
+            factors.append(str(self.layer_policy.sparse_layers))
+
+        if self.sparse_algo_config is not None:
+            factors.append(str(self.sparse_algo_config))
+
+        hash_str = hashlib.md5(str(factors).encode(),
+                               usedforsecurity=False).hexdigest()
+        return hash_str
+
+    def metrics_info(self) -> dict[str, str]:
+        """Convert config to dict for prometheus metrics info."""
+        info = {
+            "enable_sparse": str(self.enable_sparse),
+            "lc_sparse_threshold": str(self.lc_sparse_threshold),
+            "sparse_algo_type": str(self.sparse_algo_type),
+            "enable_static_sparse": str(self.enable_static_sparse),
+            "head_budget_policy": str(self.head_budget_policy),
+            "total_budget": str(self.total_budget) if self.total_budget > 100 else (str(self.total_budget) + "%"),
+        }
+
+        # Add layer policy info
+        if self.layer_policy is not None:
+            info["layer_policy.policy_type"] = str(self.layer_policy.policy_type)
+            info["layer_policy.full_attn_layers"] = str(self.layer_policy.full_attn_layers)
+            info["layer_policy.sparse_layers"] = str(self.layer_policy.sparse_layers)
+
+        if self.sparse_algo_config is not None:
+            algo_config_dict = {
+                f"sparse_algo_config.{key}": str(value)
+                for key, value in self.sparse_algo_config.__dict__.items()
+            }
+            info.update(algo_config_dict)
+
+        return info
+
