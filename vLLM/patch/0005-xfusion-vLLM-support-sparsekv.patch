diff -Nur vllm.baseline/vllm/attention/utils/kv_sparse_utils.py vllm/vllm/attention/utils/kv_sparse_utils.py
--- vllm.baseline/vllm/attention/utils/kv_sparse_utils.py	1970-01-01 08:00:00.000000000 +0800
+++ vllm/vllm/attention/utils/kv_sparse_utils.py	2026-02-05 10:23:38.393569867 +0800
@@ -0,0 +1,67 @@
+import inspect
+from collections.abc import Callable
+from functools import wraps
+
+import torch
+
+from vllm.forward_context import ForwardContext, get_forward_context
+from vsparse.core import get_sparse_agent, has_sparse_agent, SparseRunnerRole
+
+
+def maybe_execute_sparse_attention_hooks(func: Callable) -> Callable:
+    """
+    Decorator that executes sparse attention hooks before and after
+    the attention computation, if enabled. Otherwise, the wrapper is a no-op.
+
+    On entry: call the start hook of the sparse attention algorithm.
+    On exit: call the end hook of the sparse attention algorithm.
+    """
+
+    sig = inspect.signature(func)
+    param_names = list(sig.parameters.keys())
+
+    # Find the indices of required parameters
+    required_params = {"query", "key", "value", "layer_name"}
+    missing_params = required_params - set(param_names)
+    if missing_params:
+        raise TypeError(
+            f"Function {func.__name__} must have parameters: {required_params}. "
+            f"Missing: {missing_params}"
+        )
+
+    query_idx = param_names.index("query")
+    key_idx = param_names.index("key")
+    value_idx = param_names.index("value")
+    layer_name_idx = param_names.index("layer_name")
+
+    @wraps(func)
+    def wrapper(*args, **kwargs):
+        # Fast path: skip hooks if sparse attention is not enabled
+        if not has_sparse_agent(SparseRunnerRole.WORKER):
+            return func(*args, **kwargs)
+
+        # Extract required parameters from args
+        query: torch.Tensor = args[query_idx]
+        key: torch.Tensor = args[key_idx]
+        value: torch.Tensor = args[value_idx]
+        layer_name: str = args[layer_name_idx]
+
+        # Extract attention context (layer-specific metadata, layer, and kv_cache)
+        forward_context: ForwardContext = get_forward_context()
+        if forward_context.attn_metadata is None:
+            return func(*args, **kwargs)
+
+        # Execute the start hook before attention computation
+        agent = get_sparse_agent(SparseRunnerRole.WORKER)
+        agent.attention_begin(query, key, value, layer_name, forward_context)
+
+        # Execute the original function
+        result = func(*args, **kwargs)
+
+        # Execute the finished hook after attention computation
+        agent.attention_finished(query, key, value, result, layer_name, forward_context)
+
+        return result
+
+    return wrapper
+
