--- vllm.baseline/vllm/config/sparse_rules.py	1970-01-01 08:00:00.000000000 +0800
+++ vllm/vllm/config/sparse_rules.py	2026-02-05 10:23:38.393569867 +0800
@@ -0,0 +1,101 @@
+from pydantic.dataclasses import dataclass
+from typing import Optional, Any, Callable, Protocol, TYPE_CHECKING
+from dataclasses import field as dataclass_field
+
+if TYPE_CHECKING:
+    from .vllm import VllmConfig
+    from .sparse import SparseConfig, CRSAConfig
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+
+class AutoInferable(Protocol):
+    """
+    AutoInferable: All Sparse Config Classes should inherit
+    from this class to support auto-inferable methods.
+    """
+    def finalize(self, context_b: Any, context_c: Any) -> None:
+        ...
+
+
+class FieldAutoInfererRegistry:
+    def __init__(self):
+        self._inferers: list[Callable] = []
+
+    def register(self, inferer: Callable):
+        self._inferers.append(inferer)
+        return inferer
+
+    def run(self, instance: Any, context: "VllmConfig"):
+        for inferer in self._inferers:
+            try:
+                inferer(instance, context)
+            except Exception as e:
+                logger.error(f"Field Value Auto Inference failed for {inferer.__name__}: {e}")
+
+
+sparse_config_inferers = FieldAutoInfererRegistry()
+crsa_algo_inferers = FieldAutoInfererRegistry()
+
+
+@sparse_config_inferers.register
+def inferer_total_budgets(instance: "SparseConfig", context: "VllmConfig"):
+    """
+    Rules:
+        1.预算不能超出max_model_len
+    """
+    if instance.sparse_algo_type == "CRSA" and not instance.enable_dynamic_budgets:
+        model_config = context.model_config
+        total_budget = instance.total_budget
+
+        if total_budget > model_config.max_model_len:
+            raise ValueError(
+                f"sparse total_budget {total_budget} > {model_config.max_model_len}, this is not allowed.")
+
+
+@crsa_algo_inferers.register
+def inferer_num_sink_blocks(instance: "CRSAConfig", context: "VllmConfig"):
+    """
+    Rules:
+        1.Model
+        2.Block Size
+    """
+    if instance.num_sink_blocks is None:
+        block_size = context.cache_config.block_size
+        if block_size <= 128:
+            instance.num_sink_blocks = 2
+        else:
+            instance.num_sink_blocks = 1
+
+
+@crsa_algo_inferers.register
+def inferer_num_local_window_blocks(instance: "CRSAConfig", context: "VllmConfig"):
+    """
+    Rules:
+        1.Model
+        2.Block Size
+    """
+    if instance.num_local_window_blocks is None:
+        block_size = context.cache_config.block_size
+        if block_size <= 128:
+            instance.num_local_window_blocks = 16
+        else:
+            instance.num_local_window_blocks = 8
+
+
+@crsa_algo_inferers.register
+def inferer_num_prefetch_blocks(instance: "CRSAConfig", context: "VllmConfig"):
+    """
+    Rules:
+        1.Model
+        2.Block Size
+        3.Budgets
+    """
+    if instance.num_prefetch_blocks is None:
+        block_size = context.cache_config.block_size
+        if block_size <= 128:
+            instance.num_prefetch_blocks = 8
+        else:
+            instance.num_prefetch_blocks = 4
+
